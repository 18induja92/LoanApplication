# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Application Settings
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
DATABASE_PATH=data/loan_approval.db

# FastAPI Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit Configuration
STREAMLIT_PORT=8501

# LLM Configuration
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Agent Configuration
AGENT_TIMEOUT=30
MAX_RETRIES=3

# MCP Server Configuration
MCP_TIMEOUT=10

# Loan Approval Rules
MIN_CREDIT_SCORE=600
MAX_DTI_RATIO=0.45
MIN_INCOME=30000
